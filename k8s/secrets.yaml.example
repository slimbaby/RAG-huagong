# 复制为 secrets.yaml 并填入真实值：cp secrets.yaml.example secrets.yaml
# 注意：secrets.yaml 已加入 .gitignore，严禁提交真实密钥到 git
apiVersion: v1
kind: Secret
metadata:
  name: chemical-rag-secrets
  namespace: chemical-rag
type: Opaque
stringData:
  # PostgreSQL
  POSTGRES_USER: "postgres"
  POSTGRES_PASSWORD: "<CHANGE_ME>"
  # Redis
  REDIS_PASSWORD: "<CHANGE_ME>"
  # LLM API
  PREMIUM_MODEL_API_KEY: "<CHANGE_ME>"
  # Milvus
  MILVUS_USER: ""
  MILVUS_PASSWORD: ""
