# ===== Application Config =====
APP_NAME=LangGraph RAG鐭ヨ瘑搴撶郴缁?
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0

# ===== CORS Config =====
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ===== Model Config =====
PREMIUM_MODEL_PROVIDER=xiaomi
PREMIUM_MODEL_NAME=mimo-v2.5
PREMIUM_MODEL_API_KEY=<key>
PREMIUM_MODEL_API_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
PREMIUM_MODEL_TEMPERATURE=0.7
PREMIUM_MODEL_MAX_TOKENS=4096
PREMIUM_MODEL_MAX_CONCURRENT=10

STANDARD_MODEL_PROVIDER=xiaomi
STANDARD_MODEL_NAME=mimo-v2.5-pro
STANDARD_MODEL_API_KEY=<key>
STANDARD_MODEL_API_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
STANDARD_MODEL_TEMPERATURE=0.7
STANDARD_MODEL_MAX_TOKENS=2048
STANDARD_MODEL_MAX_CONCURRENT=50

# ===== Embedding Config =====
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=BAAI/bge-base-zh-v1.5
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=
EMBEDDING_DIMENSION=768

# ===== Milvus Config =====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=document_chunks
MILVUS_USER=
MILVUS_PASSWORD=

# ===== RAGFlow Config =====
RAGFLOW_ENABLED=true
RAGFLOW_HOST=localhost
RAGFLOW_PORT=9380
RAGFLOW_API_KEY=ragflow-xxxxxxxxxxxx
RAGFLOW_DATASET_NAME=chemical-rag-main
RAGFLOW_POLL_INTERVAL=2.0
RAGFLOW_POLL_TIMEOUT=300.0
RAGFLOW_FALLBACK_TO_LOCAL=true

# ===== BM25 Config =====
BM25_K1=1.5
BM25_B=0.75
BM25_INDEX_PATH=./bm25_index/index

# ===== Hybrid Retrieval Config =====
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4
HYBRID_FUSION_METHOD=rrf
HYBRID_TOP_K=5

# ===== HNSW Config =====
HNSW_M=32
HNSW_EF_CONSTRUCTION=256
HNSW_EF_SEARCH=128
HNSW_METRIC_TYPE=COSINE

# ===== RAG Config =====
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# ===== OCR Config =====
OCR_ENGINE=paddleocr
PADDLEOCR_LANG=ch
TESSERACT_LANG=chi_sim+eng

# ===== File Upload Config =====
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=[".pdf",".docx",".xlsx",".xls",".csv",".json",".txt",".md"]

# ===== PostgreSQL Config =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=chemical_rag

# ===== Redis Config =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=infiniflow

# ===== Error Notification Config =====
ERROR_WEBHOOK_URL=
NOTIFICATION_EMAIL=admin@example.com

# ===== Law Crawler Config =====
CRAWLER_ENABLED=true
CRAWLER_PROXY=
CRAWLER_REQUEST_DELAY=2.0
CRAWLER_MAX_RETRIES=3

# ===== File Storage Config =====
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./law_archives

# ===== ERP Config (棰勭暀) =====
ERP_API_BASE_URL=
ERP_API_KEY=
