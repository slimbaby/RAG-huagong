# docker compose 插值变量模板
# 用法：cp docker/.env.example docker/.env 后填入真实值
# 注意：compose 插值只读取本目录 docker/.env 或 shell 环境变量，根目录 .env 对插值无效
# 所有密码项在 docker-compose.yml 中为必填（:? 语法），缺失会拒绝启动
# 生成强密码：openssl rand -base64 24

# Redis（会话/任务状态；backend 与 redis 服务同源读取，改这一处即可）
REDIS_PASSWORD=change-me-strong-password

# PostgreSQL（评测数据/用户；注意：volume 首次初始化后改密码需同步改卷内密码）
POSTGRES_PASSWORD=change-me-strong-password

# MySQL（RAGFlow 依赖）
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_PASSWORD=change-me-strong-password

# MinIO（RAGFlow 对象存储）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-password

# RAGFlow 会话密钥
RAGFLOW_SECRET_KEY=change-me-random-string

# HuggingFace 模型缓存（可选）：
# - 不设置：使用命名卷 hf_cache（可移植，首次启动需下载 ~2GB 模型）
# - 设置为宿主机路径：复用已有缓存，如 C:/Users/<you>/.cache/huggingface 或 ~/.cache/huggingface
# HF_CACHE_DIR=
