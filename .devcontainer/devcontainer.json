{
  "name": "RAG Backend",
  "dockerComposeFile": "${localWorkspaceFolder}/docker/docker-compose.yml",
  "service": "backend",
  "workspaceFolder": "/app",
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/app/.venv/bin/python"
      }
    }
  }
}
